{
  "name": "refund-flow",
  "homepage": "https://bryansimyf.github.io/refund-flow/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite --mode local-mock",
    "dev:local-local": "vite --mode local-local",
    "dev:dev": "vite --mode development",
    "dev:stage": "vite --mode staging",
    "build": "tsc -b && vite build --mode production",
    "build:dev": "tsc -b && vite build --mode development",
    "build:stage": "tsc -b && vite build --mode staging",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:format": "prettier --log-level warn --write \"./**/*.{ts,tsx,css,md,json}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "predeploy": "pnpm test && VITE_PUBLIC_URL=/refund-flow/ VITE_ENABLE_MOCK_API=1 pnpm run build && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.105.0",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "8.2.3",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axios-mock-adapter": "2.1.0",
    "gh-pages": "^6.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "3.2.4"
  }
}
